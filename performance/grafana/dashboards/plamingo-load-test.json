{
  "uid": "plamingo-backend",
  "title": "Plamingo Backend",
  "description": "k6 부하, API 응답, Spring Boot 서버 자원을 같은 시간축에서 비교하는 대시보드",
  "tags": ["plamingo", "k6", "performance", "load-test"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "flow",
        "label": "k6 시나리오",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(k6_http_req_duration_p95, flow)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(k6_http_req_duration_p95, flow)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "endpoint",
        "label": "API",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(k6_http_req_duration_p95{flow=~\"$flow\"}, endpoint)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(k6_http_req_duration_p95{flow=~\"$flow\"}, endpoint)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "k6 부하 테스트",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "title": "Virtual Users",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(k6_vus)", "legendFormat": "vus" },
        { "refId": "B", "expr": "max(k6_vus_max)", "legendFormat": "max" }
      ]
    },
    {
      "id": 3,
      "title": "k6 요청 처리량",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(k6_http_reqs_total[1m]))", "legendFormat": "http req/s" },
        { "refId": "B", "expr": "sum(rate(k6_iterations_total[1m]))", "legendFormat": "iterations/s" }
      ]
    },
    {
      "id": 4,
      "title": "k6 응답 시간 avg / p95 / p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(k6_http_req_duration_avg)", "legendFormat": "avg" },
        { "refId": "B", "expr": "max(k6_http_req_duration_p95)", "legendFormat": "p95" },
        { "refId": "C", "expr": "max(k6_http_req_duration_p99)", "legendFormat": "p99" }
      ]
    },
    {
      "id": 5,
      "title": "k6 실패율",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.01, "color": "red" }] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(k6_http_req_failed_rate)", "legendFormat": "HTTP 실패" },
        { "refId": "B", "expr": "max(k6_realistic_flow_failures_rate)", "legendFormat": "Flow 실패" }
      ]
    },
    {
      "id": 6,
      "title": "API별 k6 지표",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "panels": []
    },
    {
      "id": 7,
      "title": "API별 요청 처리량",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (flow, endpoint) (rate(k6_http_reqs_total{flow=~\"$flow\",endpoint=~\"$endpoint\"}[1m]))", "legendFormat": "{{flow}} / {{endpoint}}" }
      ]
    },
    {
      "id": 8,
      "title": "API별 응답 시간 p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max by (flow, endpoint) (k6_http_req_duration_p95{flow=~\"$flow\",endpoint=~\"$endpoint\"})", "legendFormat": "{{flow}} / {{endpoint}}" }
      ]
    },
    {
      "id": 9,
      "title": "API별 응답 시간 p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max by (flow, endpoint) (k6_http_req_duration_p99{flow=~\"$flow\",endpoint=~\"$endpoint\"})", "legendFormat": "{{flow}} / {{endpoint}}" }
      ]
    },
    {
      "id": 10,
      "title": "Spring Boot API 지표",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "panels": []
    },
    {
      "id": 11,
      "title": "서버 초당 요청 수",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))", "legendFormat": "req/s" }]
    },
    {
      "id": 12,
      "title": "서버 URI별 응답 시간 p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "topk(10, histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])) by (le, uri, method)))", "legendFormat": "{{method}} {{uri}}" }]
    },
    {
      "id": 13,
      "title": "서버 URI별 5xx",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "{{status}} {{uri}}" }]
    },
    {
      "id": 14,
      "title": "서버 자원 지표",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "id": 15,
      "title": "HikariCP Connections",
      "description": "active가 max에 붙고 pending이 증가하면 DB 커넥션 풀 포화",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "refId": "B", "expr": "hikaricp_connections_pending", "legendFormat": "pending" },
        { "refId": "C", "expr": "hikaricp_connections_max", "legendFormat": "max" }
      ]
    },
    {
      "id": 16,
      "title": "Hikari 획득 / 점유 시간",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(hikaricp_connections_acquire_seconds_sum[1m]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count[1m]), 1e-9)", "legendFormat": "평균 획득" },
        { "refId": "B", "expr": "rate(hikaricp_connections_usage_seconds_sum[1m]) / clamp_min(rate(hikaricp_connections_usage_seconds_count[1m]), 1e-9)", "legendFormat": "평균 점유" },
        { "refId": "C", "expr": "hikaricp_connections_acquire_seconds_max", "legendFormat": "최대 획득" },
        { "refId": "D", "expr": "hikaricp_connections_usage_seconds_max", "legendFormat": "최대 점유" }
      ]
    },
    {
      "id": 17,
      "title": "CPU 사용률",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage", "legendFormat": "application" },
        { "refId": "B", "expr": "system_cpu_usage", "legendFormat": "system" }
      ]
    },
    {
      "id": 18,
      "title": "Tomcat Threads",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "tomcat_threads_busy_threads", "legendFormat": "busy" },
        { "refId": "B", "expr": "tomcat_threads_current_threads", "legendFormat": "current" },
        { "refId": "C", "expr": "tomcat_threads_config_max_threads", "legendFormat": "max" }
      ]
    },
    {
      "id": 19,
      "title": "JVM Heap 사용량",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used" },
        { "refId": "B", "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max" }
      ]
    },
    {
      "id": 20,
      "title": "GC Pause Time (1m rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "100 * sum(rate(jvm_gc_pause_seconds_sum[1m]))", "legendFormat": "pause %" }
      ]
    }
  ]
}
