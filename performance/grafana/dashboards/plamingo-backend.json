{
  "uid": "plamingo-backend-legacy",
  "title": "Plamingo Backend (기존)",
  "description": "API, HikariCP, Tomcat, CPU, GC를 같은 시간축에서 비교하는 성능 병목 분석 대시보드",
  "tags": ["plamingo", "performance", "bottleneck"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Prometheus 수집 상태",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "up{job=\"plamingo-backend\"}" }]
    },
    {
      "id": 2,
      "title": "초당 요청 수",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "req/s" }]
    },
    {
      "id": 3,
      "title": "서버 오류율 (5xx)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.01, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count[1m])), 1e-9)", "legendFormat": "5xx" }]
    },
    {
      "id": 4,
      "title": "전체 응답 시간 p95 / p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))", "legendFormat": "p95" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 5,
      "title": "URI별 응답 시간 p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "topk(10, histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])) by (le, uri, method)))", "legendFormat": "{{method}} {{uri}}" }]
    },
    {
      "id": 6,
      "title": "DB 커넥션 풀",
      "description": "active가 max에 붙고 idle이 0이면 포화",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "refId": "B", "expr": "hikaricp_connections_idle", "legendFormat": "idle" },
        { "refId": "C", "expr": "hikaricp_connections_max", "legendFormat": "max" }
      ]
    },
    {
      "id": 7,
      "title": "DB 커넥션 대기",
      "description": "pending이 0보다 크면 풀 반환을 기다리는 요청이 존재",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "hikaricp_connections_pending", "legendFormat": "pending" }]
    },
    {
      "id": 8,
      "title": "DB 커넥션 획득 / 점유 시간",
      "description": "획득 증가는 풀 대기, 점유 증가는 쿼리/트랜잭션 지연 후보",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(hikaricp_connections_acquire_seconds_sum[1m]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count[1m]), 1e-9)", "legendFormat": "평균 획득" },
        { "refId": "B", "expr": "rate(hikaricp_connections_usage_seconds_sum[1m]) / clamp_min(rate(hikaricp_connections_usage_seconds_count[1m]), 1e-9)", "legendFormat": "평균 점유" },
        { "refId": "C", "expr": "hikaricp_connections_acquire_seconds_max", "legendFormat": "최대 획득" },
        { "refId": "D", "expr": "hikaricp_connections_usage_seconds_max", "legendFormat": "최대 점유" }
      ]
    },
    {
      "id": 9,
      "title": "DB 커넥션 타임아웃",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(increase(hikaricp_connections_timeout_total[$__range]))", "legendFormat": "timeout" }]
    },
    {
      "id": 10,
      "title": "Tomcat 스레드 사용률",
      "description": "performance 프로필 재시작 후 노출. 80% 이상 지속 시 포화 후보",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 80, "color": "orange" }, { "value": 95, "color": "red" }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "100 * tomcat_threads_busy_threads / clamp_min(tomcat_threads_config_max_threads, 1)", "legendFormat": "busy %" }]
    },
    {
      "id": 11,
      "title": "Tomcat 스레드 수",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "tomcat_threads_busy_threads", "legendFormat": "busy" },
        { "refId": "B", "expr": "tomcat_threads_current_threads", "legendFormat": "current" },
        { "refId": "C", "expr": "tomcat_threads_config_max_threads", "legendFormat": "max" }
      ]
    },
    {
      "id": 12,
      "title": "프로세스 / 시스템 CPU",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.8, "color": "red" }] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage", "legendFormat": "application" },
        { "refId": "B", "expr": "system_cpu_usage", "legendFormat": "system" }
      ]
    },
    {
      "id": 13,
      "title": "JVM 힙 메모리 사용량",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used" },
        { "refId": "B", "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max" }
      ]
    },
    {
      "id": 14,
      "title": "GC 정지 시간 / 횟수",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(jvm_gc_pause_seconds_sum[1m]))", "legendFormat": "정지 초/초" },
        { "refId": "B", "expr": "sum(rate(jvm_gc_pause_seconds_count[1m]))", "legendFormat": "GC 회/초" },
        { "refId": "C", "expr": "max(jvm_gc_pause_seconds_max)", "legendFormat": "최대 정지" }
      ]
    },
    {
      "id": 15,
      "title": "URI별 5xx 오류율",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "{{status}} {{uri}}" }]
    }
  ]
}
