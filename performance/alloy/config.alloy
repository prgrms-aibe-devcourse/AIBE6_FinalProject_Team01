local.file_match "backend_logs" {
  path_targets = [{
    "__path__" = "/var/log/plamingo/backend.log",
    "job"      = "plamingo-backend",
    "log_type" = "application",
    "env"      = "performance",
  }]
}

local.file_match "access_logs" {
  path_targets = [{
    "__path__" = "/var/log/plamingo/access*.log",
    "job"      = "plamingo-access",
    "log_type" = "access",
    "env"      = "performance",
  }]
}

loki.source.file "backend_logs" {
  targets       = local.file_match.backend_logs.targets
  forward_to    = [loki.process.backend_logs.receiver]
  tail_from_end = true
}

loki.process "backend_logs" {
  stage.multiline {
    firstline     = "^\\d{4}-\\d{2}-\\d{2}"
    max_wait_time = "3s"
  }

  forward_to = [loki.write.local.receiver]
}

loki.source.file "access_logs" {
  targets       = local.file_match.access_logs.targets
  forward_to    = [loki.write.local.receiver]
  tail_from_end = true
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
